# Base URL of the fmsg Web API this server talks to (required)
FMSG_API_URL=https://api.example.com

# stdio mode only: the fmsgk_... API key for the address this server sends as.
# Leave unset in HTTP mode, where each client sends its own key as a bearer token.
FMSG_API_KEY=fmsgk_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: lets short names resolve, e.g. "bob" -> @bob@example.com
#FMSG_DEFAULT_DOMAIN=example.com
# Optional: JSON file mapping short names to full addresses
#FMSG_DIRECTORY=/path/to/directory.json

# HTTP mode
#FMSG_MCP_HOST=127.0.0.1
#FMSG_MCP_PORT=8765
#FMSG_MCP_ALLOWED_HOSTS=mcp.example.com
